# AeroSpace config, i3-style tiling for macOS.
# Lands at ~/.config/aerospace/aerospace.toml
#
# This machine has SIP enabled, so yabai is off the table: its space
# manipulation needs SIP partially disabled, and we are not doing that just
# to get a window manager. AeroSpace does the same tiling job without
# touching SIP at all, so it is the one running here.
#
# Gaps and (eventually) border colours come from the same palette every
# other themed config reads: .chezmoidata/palette.toml. AeroSpace itself has
# no light/dark variants to switch between, so this file is a direct
# template rather than a themed/ shared body with wrappers.
#
# Modifier key is alt, not cmd. cmd is already claimed by half of macOS
# (cmd+w, cmd+q, cmd+tab, ...) and fighting that is a losing game, so this
# config stays out of the way and binds everything on alt instead.

after-login-command = []
after-startup-command = [
  # JankyBorders draws the active-window border; theme colours for it live
  # in ~/.config/borders/bordersrc, generated from this same palette.
  'exec-and-forget borders',
  # sketchybar replaces the menu bar. It reads
  # ~/.config/sketchybar/sketchybarrc, also generated from the palette.
  'exec-and-forget sketchybar',
]

# SketchyBar has no native AeroSpace integration, so AeroSpace has to push the
# workspace change to it. This fires the custom aerospace_workspace_change
# event that the space.N items in sketchybarrc subscribe to; without it those
# indicators render once and then never update.
exec-on-workspace-change = [
  '/bin/bash',
  '-c',
  'sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE',
]

start-at-login = true

enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

accordion-padding = 30

default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'

on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

[gaps]
inner.horizontal = 8
inner.vertical = 8
outer.left = 8
outer.bottom = 8
outer.top = 8
outer.right = 8

[mode.main.binding]
alt-h = 'focus left'
alt-j = 'focus down'
alt-k = 'focus up'
alt-l = 'focus right'

alt-shift-h = 'move left'
alt-shift-j = 'move down'
alt-shift-k = 'move up'
alt-shift-l = 'move right'

alt-minus = 'resize smart -50'
alt-equal = 'resize smart +50'

alt-1 = 'workspace 1'
alt-2 = 'workspace 2'
alt-3 = 'workspace 3'
alt-4 = 'workspace 4'
alt-5 = 'workspace 5'
alt-6 = 'workspace 6'
alt-7 = 'workspace 7'
alt-8 = 'workspace 8'
alt-9 = 'workspace 9'

alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'
alt-shift-5 = 'move-node-to-workspace 5'
alt-shift-6 = 'move-node-to-workspace 6'
alt-shift-7 = 'move-node-to-workspace 7'
alt-shift-8 = 'move-node-to-workspace 8'
alt-shift-9 = 'move-node-to-workspace 9'

alt-slash = 'layout tiles horizontal vertical'
alt-comma = 'layout accordion'

alt-f = 'fullscreen'

alt-shift-semicolon = 'mode service'

[mode.service.binding]
esc = ['reload-config', 'mode main']
r = ['flatten-workspace-tree', 'mode main']
f = ['layout floating tiling', 'mode main']
backspace = ['close-all-windows-but-current', 'mode main']
alt-shift-semicolon = 'mode main'
