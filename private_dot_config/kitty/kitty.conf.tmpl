# Shared theme is managed by ~/bin/theme or ~/bin/switch-theme.
include theme-current.conf

# Keep existing configuration from your template
# Resolve the real shell path at apply time instead of pinning /bin/*.
{{ if eq .chezmoi.os "darwin" -}}
shell {{ lookPath "zsh" | default "/bin/zsh" }}
{{ else -}}
shell {{ lookPath "bash" | default "/bin/bash" }}
{{ end }}

font_family Fira Code
font_size 16.0
adjust_line_height 2

allow_remote_control socket-only
listen_on unix:/tmp/kitty-theme

# Tab bar styling
tab_bar_min_tabs            2
tab_bar_edge                bottom
tab_bar_style               powerline
tab_powerline_style         slanted
tab_title_template          {title}{' :{}:'.format(num_windows) if num_windows > 1 else ''}

# Spacing
tab_bar_margin_height 2.0
tab_bar_margin_width 8.0
