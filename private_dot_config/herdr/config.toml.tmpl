{{- $c := .palette.everforest.dark -}}
{{- /* Colors come from .chezmoidata/palette.toml. Pinned to dark: herdr has
       no light variant wired into ~/bin/theme yet. */ -}}
# Herdr configuration
# Docs: https://herdr.dev/docs/configuration/

# Skip first-run onboarding.
onboarding = false

# Everforest (dark soft) — no built-in everforest theme exists, so the
# palette from ~/.config/tmux/everforest-dark.conf is mapped onto Herdr's
# color tokens. Note: theme auto_switch only works with built-in theme
# names, so light/dark switching via switch-theme does not apply here.
[theme]
name = "kanagawa" # dark base; every token below overrides it
[theme.custom]
accent = "{{ $c.green }}" # green
panel_bg = "{{ $c.bg0 }}" # bg0
surface_dim = "{{ $c.bg_dim }}" # bg_dim
surface0 = "{{ $c.bg1 }}" # bg1
surface1 = "{{ $c.bg2 }}" # bg2
overlay0 = "{{ $c.bg3 }}" # bg3
overlay1 = "{{ $c.bg5 }}" # bg5
text = "{{ $c.fg }}" # fg
subtext0 = "{{ $c.grey2 }}" # grey2
mauve = "{{ $c.purple }}" # purple
green = "{{ $c.green }}"
yellow = "{{ $c.yellow }}"
red = "{{ $c.red }}"
blue = "{{ $c.blue }}"
teal = "{{ $c.aqua }}" # aqua
peach = "{{ $c.orange }}" # orange

[terminal]
{{ if eq .chezmoi.os "darwin" -}}
default_shell = "{{ lookPath "zsh" | default "/bin/zsh" }}"
{{ else -}}
default_shell = "{{ lookPath "bash" | default "/bin/bash" }}"
{{ end -}}
new_cwd = "follow" # new panes/tabs inherit the current directory (like tmux -c)

[keys]
prefix = "ctrl+b"
# tmux-style splits on top of the defaults (prefix+v / prefix+minus)
split_vertical = ["prefix+v", "prefix+percent"] # side by side, like tmux %
split_horizontal = ["prefix+minus", "prefix+quote"] # stacked, like tmux "
# indexed tab/workspace switching (tmux base-index 1 equivalent)
switch_tab = "prefix+1..9"
switch_workspace = "prefix+shift+1..9"

[ui]
accent = "{{ $c.green }}" # everforest green for highlights/borders

# Notify in-app when a background agent finishes or needs input.
[ui.toast]
delivery = "herdr"
delay_seconds = 1
