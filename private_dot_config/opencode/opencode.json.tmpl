{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "agent": {
    "plan": {},
    "review": {
      "description": "Reviews code, plans, and diffs for correctness, security, and maintainability. Read-only; ALWAYS invoke after completing implementation to review the diff before finishing.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "explore": {
      "description": "Fast, read-only codebase exploration. ALWAYS use this instead of searching the codebase yourself — file lookups, keyword searches, codebase questions. Launch multiple explore agents in parallel for independent questions."
    },
    "general": {
      "description": "General-purpose subagent for research and multi-step implementation work. Delegate independent units of work to multiple general agents IN PARALLEL instead of doing everything sequentially in the main thread."
    },
    "title": {},
    "summary": {},
    "compaction": {}
  },
  "lsp": {
    "laravel-lsp": {
      "command": ["laravel-lsp"],
      "extensions": [".php", ".blade.php"]
    }
  },
  {{ template "private_dot_config/mcp_servers.json" dict "format" "opencode" }}
}
