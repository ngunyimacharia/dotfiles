{{- $kimiModel := "kimi-for-coding/k3" -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-v4-flash",
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "agent": {
    "plan": {
      "model": "{{ $kimiModel }}"
    },
    "review": {
      "description": "Reviews code, plans, and diffs for correctness, security, and maintainability. Read-only; uses Kimi for higher-quality reasoning. ALWAYS invoke after completing implementation to review the diff before finishing. If Kimi credits are exhausted, skip this agent or switch its model.",
      "mode": "subagent",
      "model": "{{ $kimiModel }}",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "explore": {
      "description": "Fast, read-only codebase exploration. ALWAYS use this instead of searching the codebase yourself — file lookups, keyword searches, codebase questions. Launch multiple explore agents in parallel for independent questions.",
      "model": "deepseek/deepseek-v4-flash"
    },
    "general": {
      "description": "General-purpose subagent for research and multi-step implementation work. Delegate independent units of work to multiple general agents IN PARALLEL instead of doing everything sequentially in the main thread.",
      "model": "deepseek/deepseek-chat"
    },
    "title": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "summary": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "compaction": {
      "model": "deepseek/deepseek-v4-flash"
    }
  },
  "lsp": {
    "laravel-lsp": {
      "command": ["laravel-lsp"],
      "extensions": [".php", ".blade.php"]
    }
  },
  {{ template "private_dot_config/mcp_servers.json" dict "format" "opencode" }}
}
