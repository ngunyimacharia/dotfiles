# ~/.bashrc — used on Linux. macOS uses ~/.zshrc instead (see .chezmoiignore).
# Everything shared between the two lives in .chezmoitemplates/shell/common.sh,
# so add cross-machine settings there, not here.

# Trust whatever the login shell already exported; only fill SHELL in if it is
# somehow unset. The old hardcoded "/bin/bash" lied on any machine where bash
# is not at that path.
: "${SHELL:={{ lookPath "bash" | default "/bin/bash" }}}"
export SHELL

{{ template "shell/common.sh" . }}

# ---------------------------------------------------------------------------
# bash-specific setup
# ---------------------------------------------------------------------------

# nvm's completion is bash-only; NVM_DIR is exported in the shared template.
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# lerd's completion needs no line here: bash-completion autoloads it from
# ~/.local/share/bash-completion/completions. The zsh side needs an fpath entry.

# Initialize Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Initialize zoxide (replaces cd command)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash --cmd cd)"
fi
