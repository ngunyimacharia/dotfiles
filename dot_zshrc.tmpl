# ~/.zshrc — used on macOS. Linux uses ~/.bashrc instead (see .chezmoiignore).
# Everything shared between the two lives in .chezmoitemplates/shell/common.sh,
# so add cross-machine settings there, not here.

# Trust whatever the login shell already exported; only fill SHELL in if it is
# somehow unset. The old hardcoded "/bin/zsh" lied on any machine where zsh
# is not at that path (a Homebrew zsh, for example).
: "${SHELL:={{ lookPath "zsh" | default "/bin/zsh" }}}"
export SHELL

{{ template "shell/common.sh" . }}

# ---------------------------------------------------------------------------
# zsh-specific setup
# ---------------------------------------------------------------------------

# Lerd completions. A missing directory in fpath is harmless in zsh.
fpath=($HOME/.local/share/zsh/site-functions $fpath)

autoload -Uz compinit
compinit -i

# Initialize Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Initialize zoxide (replaces cd command)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi
