#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
script_path="$repo_root/bin/executable_opencode-afk"

if [ ! -x "$script_path" ]; then
  script_path="$repo_root/bin/opencode-afk"
fi

tmp_root=$(mktemp -d)
trap 'rm -rf "$tmp_root"' EXIT INT TERM HUP

temp_home="$tmp_root/home"
temp_bin="$tmp_root/bin"
temp_root="$tmp_root/root"
activity_log="$tmp_root/activity.log"
prompt_log="$tmp_root/prompts.log"

mkdir -p "$temp_home/.config/opencode/prompts" "$temp_bin" "$temp_root/.scratch/feature-a/issues" "$temp_root/.scratch/feature-b/issues"

printf '.scratch/\n' > "$temp_root/.gitignore"

cat > "$temp_home/.config/opencode/prompts/afk-prompt.md" <<'EOF'
Verification prompt
EOF

cat > "$temp_bin/opencode" <<EOF
#!/bin/sh

activity_log="$activity_log"
prompt_log="$prompt_log"

case "\$1" in
  run)
    prompt=\$5
    issue_ref=\$(printf '%s\n' "\$prompt" | awk -F': ' '/^Issue reference: / { print \$2; exit }')
    printf 'START %s\n' "\$issue_ref" >> "\$activity_log"
    printf 'PROMPT %s\n%s\n---\n' "\$issue_ref" "\$prompt" >> "\$prompt_log"
    case "\$issue_ref" in
      feature-a/01-alpha) sleep 2 ;;
      feature-a/02-beta) sleep 0 ;;
      feature-b/01-gamma) sleep 0 ;;
    esac
    printf 'END %s\n' "\$issue_ref" >> "\$activity_log"
    exit 0
    ;;
  models)
    echo "fixture-model"
    exit 0
    ;;
esac

exit 0
EOF

cat > "$temp_bin/fzf" <<'EOF'
#!/bin/sh

awk 'NR == 1 { print; exit }'
EOF

chmod +x "$temp_bin/opencode" "$temp_bin/fzf"

create_issue() {
  root="$1"
  relative_path="$2"
  frontmatter_block="$3"
  status_line="$4"
  body="$5"

  issue_path="$root/$relative_path"
  mkdir -p "$(dirname "$issue_path")"
  {
    if [ -n "$frontmatter_block" ]; then
      printf '%s\n' "$frontmatter_block"
    fi
    printf '# %s\n\n' "$(basename "$relative_path" .md)"
    printf '%s\n\n' "$status_line"
    printf '%s\n' "$body"
  } > "$issue_path"
}

frontmatter_alpha=$(cat <<'EOF'
---
afk_worktree: custom-alpha
afk_branch: afk/custom-alpha
---
EOF
)

create_issue "$temp_root" ".scratch/feature-a/issues/01-alpha.md" "$frontmatter_alpha" 'Status: ready-for-agent' '## Summary

Alpha ticket with overrides.'

create_issue "$temp_root" ".scratch/feature-a/issues/02-beta.md" '' 'Status: ready-for-agent' '## Summary

Beta ticket in same feature.'

create_issue "$temp_root" ".scratch/feature-b/issues/01-gamma.md" '' 'Status: ready-for-agent' '## Summary

Gamma ticket in different feature.'

assert_contains() {
  needle="$1"
  file_path="$2"
  if ! awk -v needle="$needle" 'BEGIN { found = 0 } { if (index($0, needle) > 0) found = 1 } END { exit found ? 0 : 1 }' "$file_path"; then
    echo "[ERROR] missing expected output: $needle" >&2
    echo "[ERROR] in file: $file_path" >&2
    exit 1
  fi
}

assert_order() {
  first="$1"
  second="$2"
  file_path="$3"
  first_line=$(awk -v needle="$first" 'index($0, needle) > 0 { print NR; exit }' "$file_path")
  second_line=$(awk -v needle="$second" 'index($0, needle) > 0 { print NR; exit }' "$file_path")

  if [ -z "$first_line" ] || [ -z "$second_line" ] || [ "$first_line" -ge "$second_line" ]; then
    echo "[ERROR] unexpected order: $first before $second" >&2
    echo "[ERROR] in file: $file_path" >&2
    exit 1
  fi
}

output_log="$tmp_root/launcher.log"
timeout_seconds=30
start_epoch=$(date +%s)

if (
  cd "$temp_root" && env PATH="$temp_bin:$PATH" HOME="$temp_home" "$script_path" --model fixture-model
) > "$output_log" 2>&1; then
  :
else
  echo "[ERROR] launcher fixture run failed" >&2
  cat "$output_log" >&2
  exit 1
fi

assert_contains "Selected 3 AFK ticket(s):" "$output_log"
assert_contains "feature-a/01-alpha" "$output_log"
assert_contains "feature-a/02-beta" "$output_log"
assert_contains "feature-b/01-gamma" "$output_log"
assert_contains "Launch complete. Exiting without waiting for ticket completion." "$output_log"

while :; do
  done_count=$(find "$temp_root/.scratch/.opencode-afk-logs/sentinels" -name '*.done' -o -name '*.failed' 2>/dev/null | wc -l | tr -d ' ')
  if [ "$done_count" -ge 3 ]; then
    break
  fi

  now=$(date +%s)
  if [ $((now - start_epoch)) -ge "$timeout_seconds" ]; then
    echo "[ERROR] timed out waiting for ticket completion" >&2
    cat "$activity_log" >&2
    exit 1
  fi

  sleep 1
done

assert_contains "START feature-a/01-alpha" "$activity_log"
assert_contains "END feature-a/01-alpha" "$activity_log"
assert_contains "START feature-a/02-beta" "$activity_log"
assert_contains "START feature-b/01-gamma" "$activity_log"

assert_order "END feature-a/01-alpha" "START feature-a/02-beta" "$activity_log"

assert_contains "Feature slug: feature-a" "$prompt_log"
assert_contains "Ticket path: $temp_root/.scratch/feature-a/issues/01-alpha.md" "$prompt_log"
assert_contains "Default worktree name: feature-a" "$prompt_log"
assert_contains "Default worktree path: $temp_root/.git/worktrees/feature-a" "$prompt_log"
assert_contains "Default branch: afk/feature-a" "$prompt_log"
assert_contains "AFK worktree override: custom-alpha" "$prompt_log"
assert_contains "AFK branch override: afk/custom-alpha" "$prompt_log"
assert_contains "Effective worktree name: custom-alpha" "$prompt_log"
assert_contains "Effective branch: afk/custom-alpha" "$prompt_log"
assert_contains "Feature slug: feature-b" "$prompt_log"
assert_contains "Default worktree name: feature-b" "$prompt_log"

echo "Launcher context and serialization verification passed."
