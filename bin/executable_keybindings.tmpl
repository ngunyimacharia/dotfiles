#!/bin/sh

set -eu

# Print the shared UI keybindings. Generated from .chezmoidata/keybindings.toml,
# the same table that produces the AeroSpace config on macOS and the gsettings
# script on GNOME, so this cannot drift from what is actually bound.

if [ "$(uname)" = "Darwin" ]; then
  os="macos"
else
  os="linux"
fi

case "${1:-}" in
  --all | -a) os="both" ;;
  --help | -h)
    echo "Usage: ${0##*/} [--all]"
    echo ""
    echo "Shows the keybindings active on this machine."
    echo "  --all   show every binding, including the ones this OS cannot do"
    exit 0
    ;;
esac

show_row() {
  where="$3"
  if [ "$os" != "both" ] && [ "$where" != "both" ] && [ "$where" != "$os" ]; then
    return 0
  fi
  printf '%-24s %-20s %-7s %s\n' "$1" "$2" "$where" "$4"
}

printf '%-24s %-20s %-7s %s\n' "ACTION" "KEY" "WHERE" "NOTE"

{{- range .keybinding }}
{{- $mac := and (hasKey . "aerospace_key") (ne .aerospace_key "") }}
{{- $gnome := or (hasKey . "gnome_key") (hasKey . "gnome_command") }}
{{- $manual := and (hasKey . "manual") .manual }}
{{- $key := "" }}
{{- if $mac }}{{ $key = .aerospace_key }}{{ else if hasKey . "gnome_binding" }}{{ $key = .gnome_binding }}{{ end }}
{{- /* Normalise AeroSpace's alt-shift-h and GNOME's <Alt><Shift>h to one
       neutral spelling, so a row that applies to both machines does not have
       to pick one side's syntax to display. */}}
{{- $key = $key | replace "alt-shift-" "Alt+Shift+" | replace "alt-" "Alt+" | replace "<Alt><Shift>" "Alt+Shift+" | replace "<Alt>" "Alt+" | title }}
{{- $where := "linux" }}
{{- if and (or $mac $manual) $gnome }}{{ $where = "both" }}{{ else if or $mac $manual }}{{ $where = "macos" }}{{ end }}
show_row '{{ .label }}' '{{ $key }}' '{{ $where }}' '{{ if hasKey . "note" }}{{ .note | replace "'" "'\\''" }}{{ end }}'
{{- end }}

{{- $ws := .workspaces }}
show_row 'Switch to workspace 1-{{ $ws.count }}' 'Alt+1 .. Alt+{{ $ws.count }}' 'both' ''
show_row 'Move to workspace 1-{{ $ws.count }}' 'Alt+Shift+1 .. {{ $ws.count }}' 'both' ''
