#!/bin/sh

set -eu

# Print the GNOME UI keybindings. Generated from .chezmoidata/keybindings.toml,
# the same table run_onchange_gnome-keybindings.sh applies, so this cannot drift
# from what is actually bound.

case "${1:-}" in
  --help | -h)
    echo "Usage: ${0##*/}"
    echo ""
    echo "Shows the UI keybindings applied from .chezmoidata/keybindings.toml."
    exit 0
    ;;
esac

if [ "$(uname)" = "Darwin" ]; then
  echo "These bindings are GNOME-only; nothing applies them on macOS."
  echo "Raycast and the system keyboard settings own shortcuts there."
  exit 0
fi

printf '%-24s %-20s %s\n' "ACTION" "KEY" "NOTE"

{{- range .keybinding }}
{{- $key := .gnome_binding | replace "<Alt><Shift>" "Alt+Shift+" | replace "<Alt>" "Alt+" | title }}
printf '%-24s %-20s %s\n' '{{ .label }}' '{{ $key }}' '{{ if hasKey . "note" }}{{ .note | replace "'" "'\\''" }}{{ end }}'
{{- end }}

{{- $ws := .workspaces }}
printf '%-24s %-20s %s\n' 'Switch to workspace 1-{{ $ws.count }}' 'Alt+1 .. Alt+{{ $ws.count }}' ''
printf '%-24s %-20s %s\n' 'Move to workspace 1-{{ $ws.count }}' 'Alt+Shift+1 .. {{ $ws.count }}' ''
