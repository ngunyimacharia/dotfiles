#!/bin/sh

set -eu

MODE_FILE="$HOME/.current_theme_mode"
KITTY_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kitty"
KITTY_CURRENT_THEME="$KITTY_CONFIG_DIR/theme-current.conf"
KITTY_SOCKET="unix:/tmp/kitty-theme"
TMUX_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
BTOP_CONFIG_FILE="$CONFIG_DIR/btop/btop.conf"
BACKGROUND_DIR="$HOME/.local/share/backgrounds"

show_usage() {
  echo "Usage: ${0##*/} [dark|light|auto|status]"
  echo ""
  echo "Examples:"
  echo "  ${0##*/} auto"
  echo "  ${0##*/} light"
  echo "  ${0##*/} dark"
}

detect_os_mode() {
  if [ "$(uname)" = "Darwin" ]; then
    if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi "dark"; then
      echo "dark"
    else
      echo "light"
    fi
    return
  fi

  if command -v gsettings >/dev/null 2>&1; then
    if gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | grep -q "prefer-dark"; then
      echo "dark"
    else
      echo "light"
    fi
    return
  fi

  if [ -f "$MODE_FILE" ]; then
    cat "$MODE_FILE"
  else
    echo "dark"
  fi
}

# Swap a themed config into the place its app actually reads. Each app owns a
# plain "current" file; the light and dark variants next to it are managed by
# chezmoi and generated from .chezmoidata/palette.toml.
apply_variant() {
  variant="$1"
  active="$2"
  [ -f "$variant" ] || return 0
  mkdir -p "$(dirname "$active")"
  cp "$variant" "$active"
}

apply_starship() {
  apply_variant "$CONFIG_DIR/starship-$mode.toml" "$CONFIG_DIR/starship.toml"
  # starship re-reads its config on every prompt, so there is nothing to signal.
}

apply_fastfetch() {
  apply_variant "$CONFIG_DIR/fastfetch/config-$mode.jsonc" \
    "$CONFIG_DIR/fastfetch/config.jsonc"
}

# btop rewrites btop.conf itself when it exits, so we edit the one line we own
# rather than managing the whole file and fighting it.
apply_btop() {
  [ -f "$BTOP_CONFIG_FILE" ] || return 0
  if grep -q '^color_theme' "$BTOP_CONFIG_FILE"; then
    tmp="$BTOP_CONFIG_FILE.theme-tmp"
    sed "s|^color_theme.*|color_theme = \"everforest-$mode\"|" \
      "$BTOP_CONFIG_FILE" > "$tmp" && mv "$tmp" "$BTOP_CONFIG_FILE"
  else
    printf 'color_theme = "everforest-%s"\n' "$mode" >> "$BTOP_CONFIG_FILE"
  fi

  # Only signal a btop that is actually running; SIGUSR2 makes it reload.
  if pgrep -x btop >/dev/null 2>&1; then
    pkill -USR2 -x btop >/dev/null 2>&1 || true
  fi
}

# GTK reads one fixed filename per major version, so the light and dark variants
# sit next to it and get copied over. Neither GTK3 nor GTK4 watches the file, so
# windows that are already open keep their old colors until the app restarts.
apply_gtk() {
  apply_variant "$CONFIG_DIR/gtk-3.0/gtk-$mode.css" "$CONFIG_DIR/gtk-3.0/gtk.css"
  apply_variant "$CONFIG_DIR/gtk-4.0/gtk-$mode.css" "$CONFIG_DIR/gtk-4.0/gtk.css"
}

# The GNOME Shell stylesheet only loads through the User Themes extension. When
# that extension is absent its schema is absent too, so check before setting and
# stay quiet rather than erroring on a machine that does not have it.
apply_gnome_shell_theme() {
  command -v gsettings >/dev/null 2>&1 || return 0
  gsettings list-schemas 2>/dev/null |
    grep -qx "org.gnome.shell.extensions.user-theme" || return 0
  [ -d "$HOME/.themes/everforest-$mode/gnome-shell" ] || return 0
  gsettings set org.gnome.shell.extensions.user-theme name "everforest-$mode" \
    >/dev/null 2>&1 || true
}

# GNOME keeps separate wallpaper keys for light and dark and picks between them
# from color-scheme, so both get pointed at their image every time and the swap
# then follows the mode for free. macOS has one desktop picture, so it gets the
# image for the mode we are switching into.
apply_wallpaper() {
  if [ "$(uname)" = "Darwin" ]; then
    [ -f "$BACKGROUND_DIR/everforest-$mode.png" ] || return 0
    osascript -e "tell application \"System Events\" to set picture of every desktop to \"$BACKGROUND_DIR/everforest-$mode.png\"" >/dev/null 2>&1 || true
    return 0
  fi

  command -v gsettings >/dev/null 2>&1 || return 0
  [ -f "$BACKGROUND_DIR/everforest-dark.png" ] || return 0
  [ -f "$BACKGROUND_DIR/everforest-light.png" ] || return 0

  gsettings set org.gnome.desktop.background picture-uri \
    "file://$BACKGROUND_DIR/everforest-light.png" >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.background picture-uri-dark \
    "file://$BACKGROUND_DIR/everforest-dark.png" >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.background picture-options "zoom" >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.screensaver picture-uri \
    "file://$BACKGROUND_DIR/everforest-$mode.png" >/dev/null 2>&1 || true
}

# Papirus ships matching light and dark icon sets. Fall back silently to
# whatever is already set when it is not installed.
apply_icons() {
  command -v gsettings >/dev/null 2>&1 || return 0
  if [ "$mode" = "light" ]; then
    want="Papirus-Light"
  else
    want="Papirus-Dark"
  fi
  for dir in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
    if [ -d "$dir/$want" ]; then
      gsettings set org.gnome.desktop.interface icon-theme "$want" >/dev/null 2>&1 || true
      return 0
    fi
  done
}

# macOS exposes no user color scheme, so these two keys are the only system
# colors the palette can reach. Both only apply to apps launched afterwards.
apply_macos_colors() {
  [ "$(uname)" = "Darwin" ] || return 0
  if [ "$mode" = "light" ]; then
    highlight="{{ .palette.everforest.light.macos.highlight_color }}"
    accent="{{ .palette.everforest.light.macos.accent_color }}"
  else
    highlight="{{ .palette.everforest.dark.macos.highlight_color }}"
    accent="{{ .palette.everforest.dark.macos.accent_color }}"
  fi
  defaults write -g AppleHighlightColor -string "$highlight" >/dev/null 2>&1 || true
  defaults write -g AppleAccentColor -int "$accent" >/dev/null 2>&1 || true
}

# sketchybar and borders are the macOS stand-ins for a themed panel and window
# chrome. Only signal them when they are actually running.
apply_macos_bars() {
  [ "$(uname)" = "Darwin" ] || return 0

  apply_variant "$CONFIG_DIR/sketchybar/sketchybarrc-$mode" \
    "$CONFIG_DIR/sketchybar/sketchybarrc"
  [ -f "$CONFIG_DIR/sketchybar/sketchybarrc" ] &&
    chmod +x "$CONFIG_DIR/sketchybar/sketchybarrc" 2>/dev/null || true
  if pgrep -x sketchybar >/dev/null 2>&1; then
    sketchybar --reload >/dev/null 2>&1 || true
  fi

  apply_variant "$CONFIG_DIR/borders/bordersrc-$mode" "$CONFIG_DIR/borders/bordersrc"
  [ -f "$CONFIG_DIR/borders/bordersrc" ] &&
    chmod +x "$CONFIG_DIR/borders/bordersrc" 2>/dev/null || true
  # borders has no reload signal, so bounce it instead, and only if it was up.
  if pgrep -x borders >/dev/null 2>&1; then
    pkill -x borders >/dev/null 2>&1 || true
    "$CONFIG_DIR/borders/bordersrc" >/dev/null 2>&1 &
  fi
}

# Follow the switch through to the desktop, so GTK apps and system chrome match
# the terminal instead of staying on whatever they were.
apply_os_appearance() {
  if [ "$(uname)" = "Darwin" ]; then
    osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $([ "$mode" = dark ] && echo true || echo false)" >/dev/null 2>&1 || true
    return 0
  fi

  command -v gsettings >/dev/null 2>&1 || return 0
  if [ "$mode" = "light" ]; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-light" >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita" >/dev/null 2>&1 || true
  else
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark" >/dev/null 2>&1 || true
  fi
}

reload_kitty() {
  if ! command -v kitty >/dev/null 2>&1; then
    return 0
  fi

  if kitty @ --to "$KITTY_SOCKET" set-colors --all --configured "$KITTY_CURRENT_THEME" >/dev/null 2>&1; then
    echo "Updated running kitty windows."
    return 0
  fi

  if kitty @ set-colors --all --configured "$KITTY_CURRENT_THEME" >/dev/null 2>&1; then
    echo "Updated current kitty window."
    return 0
  fi

  echo "Kitty theme file updated. Restart kitty if no running windows changed."
}

reload_tmux() {
  if ! command -v tmux >/dev/null 2>&1; then
    return 0
  fi

  if ! tmux has-session >/dev/null 2>&1; then
    return 0
  fi

  tmux source-file "$TMUX_CONFIG_DIR/everforest-$mode.conf" >/dev/null 2>&1 || true
  tmux_fg="$(tmux show-option -gqv @everforest_fg)"
  tmux_bg0="$(tmux show-option -gqv @everforest_bg0)"
  tmux_bg2="$(tmux show-option -gqv @everforest_bg2)"
  tmux_green="$(tmux show-option -gqv @everforest_green)"

  tmux set-option -g status-style "fg=$tmux_fg,bg=$tmux_bg0,default" >/dev/null 2>&1 || true
  tmux set-option -g status-right "#[fg=$tmux_bg2,bg=$tmux_bg0]#[fg=$tmux_fg,bg=$tmux_bg2] %Y-%m-%d #[fg=$tmux_green,bg=$tmux_bg2]#[fg=$tmux_bg0,bg=$tmux_green] %H:%M " >/dev/null 2>&1 || true
  if [ -f "$HOME/.tmux/plugins/tmux-sessionx/sessionx.tmux" ]; then
    "$HOME/.tmux/plugins/tmux-sessionx/sessionx.tmux" >/dev/null 2>&1 || true
  fi
  tmux refresh-client -S >/dev/null 2>&1 || true
  echo "Updated tmux status theme."
}

# Resolve the mode inline rather than through a command substitution. A
# subshell's "exit" only ends the subshell, so the usage/status branches used to
# be captured into $mode instead of ending the script.
case "${1:-}" in
  dark|light)
    mode="$1"
    ;;
  auto)
    mode="$(detect_os_mode)"
    ;;
  "" | --help | -h)
    show_usage
    exit 0
    ;;
  status)
    if [ -f "$MODE_FILE" ]; then
      echo "Current theme mode: $(cat "$MODE_FILE")"
    else
      echo "Current theme mode: unset"
    fi
    exit 0
    ;;
  *)
    echo "Error: expected dark, light, auto, or status" >&2
    show_usage >&2
    exit 1
    ;;
esac

kitty_source="$KITTY_CONFIG_DIR/theme-everforest-$mode.conf"

if [ ! -f "$kitty_source" ]; then
  echo "Error: missing $kitty_source" >&2
  echo "Run chezmoi apply first so the managed kitty theme files exist." >&2
  exit 1
fi

mkdir -p "$KITTY_CONFIG_DIR"
cp "$kitty_source" "$KITTY_CURRENT_THEME"
printf '%s\n' "$mode" > "$MODE_FILE"

apply_starship
apply_fastfetch
apply_btop
apply_gtk
apply_os_appearance
apply_gnome_shell_theme
apply_icons
apply_wallpaper
apply_macos_colors
apply_macos_bars

reload_kitty
reload_tmux

echo "Theme mode set to $mode."
echo "Neovim will use it on next start; run :ThemeSync in an existing Neovim session."
echo "Restart opencode if its TUI does not repaint from the terminal palette."
echo "GTK apps pick up the new colors when they next start."
if [ "$(uname)" != "Darwin" ] && [ -d "$HOME/.themes/everforest-$mode/gnome-shell" ]; then
  echo "GNOME Shell restyles live on Wayland only after logging out and back in."
fi
