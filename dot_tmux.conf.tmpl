set -g mouse on # Enable mouse usage

# Allow terminal apps to copy to the system clipboard through tmux.
set -g set-clipboard on
set -g allow-passthrough on
set -g extended-keys on
# Propagate the Wayland socket to new panes so clipboard tools work (not in tmux's default list)
set -ga update-environment "WAYLAND_DISPLAY"

# Resolve the real shell path at apply time instead of pinning /bin/*, which
# is wrong on any machine with a Homebrew or distro-packaged shell.
{{ if eq .chezmoi.os "darwin" -}}
{{ $shell := lookPath "zsh" | default "/bin/zsh" -}}
set -g default-shell {{ $shell }}
set-environment -g SHELL {{ $shell }}
{{ else -}}
{{ $shell := lookPath "bash" | default "/bin/bash" -}}
set -g default-shell {{ $shell }}
set-environment -g SHELL {{ $shell }}
{{ end }}
set -g base-index 1 # Start windows at 1
set -g renumber-windows on # Renumber windows when a window is closed
setw -g mode-keys vi # Use vi keybindings in copy mode
set -g status-position bottom

# Ensure new splits and windows open in current directory
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Install plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin 'omerxx/tmux-sessionx'

set -g @sessionx-bind 'o'
set -g @sessionx-fzf-builtin-tmux 'on'

# One current file, rewritten by ~/bin/switch-theme, rather than a branch per
# mode. There are 23 themes now, so branching on mode no longer identifies one.
if-shell 'test -f ~/.config/tmux/theme-current.conf' \
  'source-file ~/.config/tmux/theme-current.conf' \
  ''

# Automatic continuum boot on Start
set -g @continuum-boot 'on'

# Install tpm on new machines
if "test ! -d ~/.tmux/plugins/tpm" \
   "run 'git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm && ~/.tmux/plugins/tpm/bin/install_plugins'"

# Initialize tpm
run '~/.tmux/plugins/tpm/tpm'

set-option -g status "on"
set -g status-interval 2

set-option -g mode-style fg='#{@theme_purple}',bg='#{@theme_bg_red}' # fg=purple, bg=bg_visual

# ---- Windows ----
# default window title colors
set-window-option -g window-status-style fg='#{@theme_bg5}',bg='#{@theme_bg0}' # fg=yellow bg=bg0

# default window with an activity alert
set-window-option -g window-status-activity-style 'bg=#{@theme_bg1},fg=#{@theme_bg3}' # bg=bg1, fg=fg3

# active window title colors
set-window-option -g window-status-current-style fg='#{@theme_fg}',bg='#{@theme_bg_green}' # fg=fg bg=bg_green

# ---- Pane ----
# pane borders
set-option -g pane-border-style fg='#{@theme_bg1}' # fg=bg1
set-option -g pane-active-border-style 'fg=#{@theme_blue}' # fg=blue

# pane number display
set-option -g display-panes-active-colour '#7fbbb3' # blue
set-option -g display-panes-colour '#e69875' # orange

# ---- Command ----
# message info
set-option -g message-style fg='#{@theme_statusline3}',bg='#{@theme_bg_dim}' # fg=statusline3 bg=bg_dim

# writing commands inactive
set-option -g message-command-style 'fg=#{@theme_bg3},bg=#{@theme_bg1}' # bg=fg3, fg=bg1

# ---- Miscellaneous ----
# clock
set-window-option -g clock-mode-colour '#7fbbb3' #blue

# bell
set-window-option -g window-status-bell-style fg='#{@theme_bg0}',bg='#{@theme_statusline3}' # fg=bg, bg=statusline3

# ---- Formatting ----
set-option -g status-left-style none
set -g status-left-length 60
set -g status-left '#[fg=#{@theme_bg_dim},bg=#{@theme_green},bold] #S #[fg=#{@theme_green},bg=#{@theme_bg0},nobold]'

set-option -g status-right-style none
set -g status-right-length 150

set -g status-right '#[fg=#{@theme_bg2},bg=#{@theme_bg0}]#[fg=#{@theme_fg},bg=#{@theme_bg2}] %Y-%m-%d #[fg=#{@theme_green},bg=#{@theme_bg2}]#[fg=#{@theme_bg0},bg=#{@theme_green}] %H:%M '

set -g window-status-separator '#[fg=#{@theme_grey2},bg=#{@theme_bg0}] '
set -g window-status-format "#[fg=#{@theme_grey0},bg=#{@theme_bg0}] #I  #[fg=#{@theme_grey0},bg=#{@theme_bg0}]#W#[fg=#{@theme_grey0},bg=#{@theme_bg0}] "
set -g window-status-current-format "#[fg=#{@theme_bg0},bg=#{@theme_bg_green}]#[fg=#{@theme_fg},bg=#{@theme_bg_green}] #I  #[fg=#{@theme_fg},bg=#{@theme_bg_green},bold]#W#[fg=#{@theme_fg},bg=#{@theme_bg_green},bold] #[fg=#{@theme_bg_green},bg=#{@theme_bg0},nobold]"
