{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "color": {
      "keys": "{{ .green }}",
      "title": "{{ .fg }}",
      "output": "{{ .fg }}"
    },
    "separator": "  "
  },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "packages", "shell",
    "terminal", "cpu", "gpu", "memory", "swap", "disk", "localip",
    "battery", "poweradapter", "break", "colors"
  ]
}
