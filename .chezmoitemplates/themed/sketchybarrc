#!/bin/sh
# SketchyBar config. Shared body for the dark, light and default copies.
# The template context is a palette mode map from .chezmoidata/palette.toml,
# so colors are referenced as {{ ".green" }}, {{ ".bg0" }} and so on.
# Rendered mode: {{ .mode }}
# Lands at ~/.config/sketchybar/sketchybarrc (must stay executable,
# SketchyBar runs this file itself on launch and on `sketchybar --reload`).
#
# This is the Omarchy-Quickshell analogue: one self-contained script, no
# separate plugins/ directory, so there is only one place to theme.
#
# Workspace indicators are driven by AeroSpace, which has no native
# SketchyBar integration. AeroSpace's exec-on-workspace-change setting
# should call:
#   sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE
# on every workspace change, so the space.N items below can react to it.

PATH="/opt/homebrew/bin:$PATH"

# The 16" MacBook Pro's Liquid Retina XDR panel has a notch. notch_width and
# notch_display_height are SketchyBar bar-level settings for exactly this
# (confirmed present since v2.22.0; this machine runs v2.24.0):
#   - notch_width=200 keeps SketchyBar's own default, which already matches
#     the physical notch width Apple documents for the 14"/16" MacBook Pro.
#     It is written out explicitly here so the choice is documented rather
#     than left to an implicit default.
#   - notch_display_height=37 raises the bar's rendered height on the
#     notched screen only, matching the 37pt menu bar height macOS itself
#     uses on notched Macs, so left/right items clear the notch instead of
#     drawing under or beside it at the plain 32pt bar height used below.
# y_offset, margin and sticky also exist on --bar, but none of them are
# notch-specific: sticky already defaults to on (bar visible on every
# space, which is what we want) and there is no need to shift the bar's
# position beyond what notch_display_height already handles, so they are
# left at their defaults rather than set here.
sketchybar --bar \
  color=0xff{{ trimPrefix "#" .bg0 }} \
  height=32 \
  position=top \
  padding_left=10 \
  padding_right=10 \
  border_color=0xff{{ trimPrefix "#" .bg3 }} \
  border_width=2 \
  notch_width=200 \
  notch_display_height=37

sketchybar --default \
  icon.font="CaskaydiaMono Nerd Font:Bold:14.0" \
  label.font="CaskaydiaMono Nerd Font:Bold:14.0" \
  icon.color=0xff{{ trimPrefix "#" .fg }} \
  label.color=0xff{{ trimPrefix "#" .fg }} \
  padding_left=5 \
  padding_right=5

##### Left side: front app #####

sketchybar --add item front_app left \
  --set front_app icon.drawing=off \
              label.color=0xff{{ trimPrefix "#" .green }} \
              script="sketchybar --set \$NAME label=\"\$INFO\"" \
  --subscribe front_app front_app_switched

##### Left side: AeroSpace workspace indicators #####

for sid in 1 2 3 4 5; do
  sketchybar --add item space.$sid left
  sketchybar --set space.$sid \
    icon="$sid" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    label.drawing=off \
    background.corner_radius=5 \
    background.height=20 \
    background.color=0x00000000 \
    icon.color=0xff{{ trimPrefix "#" .fg }} \
    click_script="aerospace workspace $sid" \
    script="sid=$sid; if [ \"\$FOCUSED_WORKSPACE\" = \"\$sid\" ]; then sketchybar --set \$NAME background.color=0xff{{ trimPrefix "#" .green }} icon.color=0xff{{ trimPrefix "#" .bg0 }}; else sketchybar --set \$NAME background.color=0x00000000 icon.color=0xff{{ trimPrefix "#" .fg }}; fi"
  sketchybar --subscribe space.$sid aerospace_workspace_change
done

##### Right side: clock, battery, cpu #####

sketchybar --add item clock right
sketchybar --set clock \
  update_freq=10 \
  icon.drawing=off \
  label.color=0xff{{ trimPrefix "#" .blue }} \
  script="sketchybar --set \$NAME label=\"\$(date '+%a %d %b %H:%M')\""

# Battery. pmset -g batt's first line names the power source ("AC Power" or
# "Battery Power"); that is what distinguishes plugged-in from running on
# battery, rather than looking for the word "charging" in the second line,
# because a full battery left on AC reports "charged" there, not
# "charging", and would otherwise look indistinguishable from discharging.
# pmset resolves from /usr/bin, which is on the minimal PATH SketchyBar
# gives item scripts, so unlike sysctl below it needs no absolute path.
sketchybar --add item battery right
sketchybar --set battery \
  update_freq=120 \
  script="batt=\$(pmset -g batt); pct=\$(echo \"\$batt\" | grep -Eo '[0-9]+%' | head -1); num=\$(echo \"\$pct\" | grep -Eo '[0-9]+'); if echo \"\$batt\" | grep -q 'AC Power'; then icon=\"\"; col=0xff{{ trimPrefix "#" .green }}; elif [ \"\$num\" -ge 60 ]; then icon=\"\"; col=0xff{{ trimPrefix "#" .yellow }}; elif [ \"\$num\" -ge 20 ]; then icon=\"\"; col=0xff{{ trimPrefix "#" .yellow }}; else icon=\"\"; col=0xff{{ trimPrefix "#" .red }}; fi; sketchybar --set \$NAME icon=\"\$icon\" icon.color=\"\$col\" label.color=\"\$col\" label=\"\$pct\""
sketchybar --subscribe battery system_woke power_source_change

# CPU. ps reports %cpu per core, so summing it across processes reaches
# ncpu*100 rather than 100; divide by the core count so the number reads the
# way a status bar implies. sysctl is called by absolute path because
# SketchyBar runs item scripts with a minimal PATH that excludes /usr/sbin,
# and a bare "sysctl" yields an empty count, an awk divide-by-zero and a
# blank label.
#
# These comments stay outside the --set block on purpose: a comment line in
# the middle of a backslash continuation ends the command early, which
# silently drops every argument after it, script= included.
sketchybar --add item cpu right
sketchybar --set cpu \
  update_freq=5 \
  icon.color=0xff{{ trimPrefix "#" .aqua }} \
  label.color=0xff{{ trimPrefix "#" .aqua }} \
  script="pct=\$(ps -A -o %cpu | awk -v n=\$(/usr/sbin/sysctl -n hw.ncpu) '{s+=\$1} END {printf \"%.0f%%\", s/n}'); sketchybar --set \$NAME icon=\"\" label=\"\$pct\""

##### Right side: wifi, volume, bluetooth #####

# Wi-Fi. The airport CLI was removed in macOS 14.4+, so SSID lookup goes
# through networksetup instead, which is still current on macOS 26.
# wifi_change fires on every connect/disconnect and hands back the new SSID
# (empty on disconnect) via $INFO, so this item is event-driven for the
# common case; update_freq=300 is only a five-minute safety net in case an
# event is ever missed, not a polling loop. networksetup lives in /usr/sbin,
# outside the minimal PATH SketchyBar gives item scripts (the same class of
# bug the cpu item's sysctl call above already hit), so it is called by
# absolute path.
# Wi-Fi. networksetup -getairportnetwork is the command most configs reach for,
# but on macOS 14 and later it answers "You are not associated with an AirPort
# network" even while connected, because the SSID is gated behind Location
# Services. ipconfig getsummary reports it without that permission. The airport
# CLI everyone else suggests was removed outright in 14.4.
sketchybar --add item wifi right
sketchybar --set wifi \
  update_freq=300 \
  script="ssid=\$(/usr/sbin/ipconfig getsummary en0 2>/dev/null | awk -F' SSID : ' '/ SSID : /{print \$2; exit}'); if [ -n \"\$ssid\" ]; then sketchybar --set \$NAME icon=\"\" icon.color=0xff{{ trimPrefix "#" .blue }} label=\"\$ssid\"; else sketchybar --set \$NAME icon=\"\" icon.color=0xff{{ trimPrefix "#" .grey1 }} label=\"Off\"; fi"
sketchybar --subscribe wifi wifi_change system_woke

# Volume. "output volume of (get volume settings)" via osascript is the
# current, supported way to read system output volume on macOS 26; nothing
# here was deprecated the way airport was. volume_change fires on every
# volume change and carries the new percent via $INFO, so update_freq=60 is
# again a safety net rather than the primary update path, cheap enough to
# not matter on battery.
sketchybar --add item volume right
sketchybar --set volume \
  update_freq=60 \
  script="vol=\$(/usr/bin/osascript -e 'output volume of (get volume settings)'); if [ \"\$vol\" -le 0 ]; then icon=\"\"; col=0xff{{ trimPrefix "#" .grey1 }}; lbl=\"Mute\"; elif [ \"\$vol\" -lt 50 ]; then icon=\"\"; col=0xff{{ trimPrefix "#" .purple }}; lbl=\"\$vol%\"; else icon=\"\"; col=0xff{{ trimPrefix "#" .purple }}; lbl=\"\$vol%\"; fi; sketchybar --set \$NAME icon=\"\$icon\" icon.color=\"\$col\" label.color=\"\$col\" label=\"\$lbl\""
sketchybar --subscribe volume volume_change

# Bluetooth. SketchyBar has no bluetooth_change event and blueutil is not
# installed on this machine, so this reads the radio's power state straight
# out of the Bluetooth daemon's own preference file instead of shelling out
# to system_profiler SPBluetoothDataType, which alone takes multiple
# seconds per call and has no business running on any interval shorter than
# "rare". ControllerPowerState is 1 when the radio is on and 0 when off; it
# reports radio-on/radio-off only, not a specific paired device, which is
# the on/off state the task asked for. defaults resolves from /usr/bin, so
# it is already on the minimal PATH and needs no absolute path. There is no
# native event to subscribe to here, so update_freq=60 is the real update
# mechanism, not just a fallback; system_woke is added so sleep/wake does
# not leave a stale reading for up to a minute.
# Bluetooth. The com.apple.Bluetooth ControllerPowerState key does not exist on
# macOS 26, so reading it always failed and the item always said Off.
# system_profiler is the reliable source and is normally avoided for being slow,
# but SPBluetoothDataType measured about 350ms per call here, which is fine at
# this interval. There is no bluetooth_change event, so the interval is the
# real mechanism rather than a fallback.
sketchybar --add item bluetooth right
sketchybar --set bluetooth \
  update_freq=60 \
  script="state=\$(/usr/sbin/system_profiler SPBluetoothDataType 2>/dev/null | awk '/State:/{print \$2; exit}'); if [ \"\$state\" = \"On\" ]; then sketchybar --set \$NAME icon=\"\" icon.color=0xff{{ trimPrefix "#" .blue }} label=\"On\"; else sketchybar --set \$NAME icon=\"\" icon.color=0xff{{ trimPrefix "#" .grey1 }} label=\"Off\"; fi"
sketchybar --subscribe bluetooth system_woke

# Native menu bar extras, rendered inside this bar.
#
# Only third-party app icons are aliased. Wi-Fi, battery, the clock and focus
# modes are available as aliases too, but aliasing those would paint Apple's
# unthemed icons next to the palette-coloured items above and show each value
# twice. App icons are the part this bar genuinely cannot draw itself, so they
# are the part worth borrowing.
#
# Requires Screen Recording permission: SketchyBar captures the real menu bar
# to reproduce these. Without it the aliases silently render as nothing, and
# "sketchybar --query default_menu_items" says so explicitly.
#
# The "Control Centre" prefix is locale-dependent and is spelled the way this
# machine reports it. On a US-locale Mac it is "Control Center", and these
# aliases would need renaming to match. Run the query above to see the real
# names. An alias naming an app that is not installed simply does not draw.
for extra in \
  "Control Centre,com.1password.1password" \
  "Control Centre,com.github.xor-gate.syncthing-macosx" \
  "Control Centre,com.wireguard.macos" \
  "Control Centre,com.if.Amphetamine" \
  "Control Centre,com.electron.ollama"; do
  sketchybar --add alias "$extra" right \
    --set "$extra" alias.scale=0.86 \
                   background.drawing=off \
                   padding_left=2 \
                   padding_right=2 2>/dev/null || true
done

sketchybar --update
