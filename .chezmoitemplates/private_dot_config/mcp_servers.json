{{- if eq .format "opencode" -}}
"mcp": {
  "context7": {
    "type": "local",
    "command": ["npx", "-y", "@upstash/context7-mcp"],
    "enabled": true
  },
  "ray": {
    "type": "remote",
    "url": "http://127.0.0.1:2411/mcp",
    "enabled": true
  }
}
{{- else if or (eq .format "kimi") (eq .format "claude") -}}
{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "ray": {
      "url": "http://127.0.0.1:2411/mcp",
      "transport": "http"
    }
  }
}
{{- end -}}
